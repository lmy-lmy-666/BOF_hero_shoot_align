<?xml version="1.0"?>
<!--
  Hero Robot — Simplified URDF for TF publishing

  This URDF defines the kinematic chain used by robot_state_publisher
  to build the TF tree. It does NOT include inertial/collision/visual
  data — it's purely for TF.

  Joint naming matches the convention expected by the control group:
    chassis → gimbal_yaw → gimbal_pitch → muzzle

  All dimensional parameters are exposed as xacro args so you can
  switch between real-robot measurements and simulation-SDF values
  at launch time without editing this file.

  Usage (real robot):
    ros2 launch hero_description hero_state_publisher.launch.py

  Usage (simulation):
    ros2 launch hero_localization bringup_sim.launch.py
      (launch file overrides args with sim-specific values)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="hero_robot">

  <!-- ======================================================================
       Dimensional Parameters (xacro args — overridable at launch)

       REAL ROBOT defaults are set here.  For SIMULATION, the launch file
       overrides them to match the Gazebo SDF model dimensions.

       HOW TO MEASURE (real robot):
         chassis_height:     distance from ground to bottom of chassis link
         gimbal_yaw_height:  Z offset from chassis origin to gimbal yaw axis
         gimbal_pitch_height: Z offset from gimbal yaw axis to pitch axis
         muzzle_forward:     X distance from pitch axis to bullet exit point
         mid360_*:           LiDAR mounting pose relative to chassis origin
       ====================================================================== -->

  <!-- === Real-robot defaults === -->
  <xacro:arg name="chassis_height"      default="0.077"/>   <!-- base→chassis Z (m) -->
  <xacro:arg name="gimbal_yaw_height"   default="0.026"/>   <!-- chassis→yaw Z offset (m) -->
  <xacro:arg name="gimbal_pitch_height" default="0.355"/>   <!-- yaw→pitch Z offset (m) -->
  <xacro:arg name="muzzle_forward"      default="0.15"/>    <!-- pitch→muzzle X offset (m) -->

  <!-- === LiDAR mounting (MID360, relative to chassis) === -->
  <xacro:arg name="mid360_x"     default="0.16"/>
  <xacro:arg name="mid360_y"     default="0.0"/>
  <xacro:arg name="mid360_z"     default="0.18"/>
  <xacro:arg name="mid360_roll"  default="0.0"/>
  <xacro:arg name="mid360_pitch" default="0.5236"/>         <!-- pi/6 ≈ 30° (real) -->
  <xacro:arg name="mid360_yaw"   default="0.0"/>

  <!-- === Bind args to properties === -->
  <xacro:property name="chassis_height"      value="$(arg chassis_height)"/>
  <xacro:property name="gimbal_yaw_height"   value="$(arg gimbal_yaw_height)"/>
  <xacro:property name="gimbal_pitch_height" value="$(arg gimbal_pitch_height)"/>
  <xacro:property name="muzzle_forward"      value="$(arg muzzle_forward)"/>
  <xacro:property name="mid360_x"     value="$(arg mid360_x)"/>
  <xacro:property name="mid360_y"     value="$(arg mid360_y)"/>
  <xacro:property name="mid360_z"     value="$(arg mid360_z)"/>
  <xacro:property name="mid360_roll"  value="$(arg mid360_roll)"/>
  <xacro:property name="mid360_pitch" value="$(arg mid360_pitch)"/>
  <xacro:property name="mid360_yaw"   value="$(arg mid360_yaw)"/>

  <!-- ======================================================================
       TF Tree:    map
                     │  (from relocalization_node)
                   odom
                     │  (from loam_adapter_node)
                 base_footprint
                     │  (fixed: base_to_chassis)
                   chassis ──────────── front_mid360  (LiDAR)
                     │  (continuous: gimbal_yaw_joint)
                 gimbal_yaw
                     │  (revolute: gimbal_pitch_joint)
                 gimbal_pitch
                     │  (fixed: muzzle_joint)
                   muzzle   ← THIS is what the control group queries
       ====================================================================== -->

  <!-- ====== Links ====== -->
  <link name="base_footprint"/>
  <link name="chassis"/>
  <link name="front_mid360"/>
  <link name="gimbal_yaw"/>
  <link name="gimbal_pitch"/>
  <link name="muzzle"/>

  <!-- ====== Joints ====== -->

  <!-- base_footprint → chassis (fixed: ground clearance) -->
  <joint name="base_to_chassis" type="fixed">
    <parent link="base_footprint"/>
    <child link="chassis"/>
    <origin xyz="0 0 ${chassis_height}" rpy="0 0 0"/>
  </joint>

  <!-- chassis → front_mid360 (fixed: LiDAR rigidly mounted on chassis) -->
  <joint name="front_livox_joint" type="fixed">
    <parent link="chassis"/>
    <child link="front_mid360"/>
    <origin xyz="${mid360_x} ${mid360_y} ${mid360_z}"
            rpy="${mid360_roll} ${mid360_pitch} ${mid360_yaw}"/>
  </joint>

  <!-- chassis → gimbal_yaw (continuous: rotates about chassis Z axis) -->
  <joint name="gimbal_yaw_joint" type="continuous">
    <parent link="chassis"/>
    <child link="gimbal_yaw"/>
    <origin xyz="0 0 ${gimbal_yaw_height}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- gimbal_yaw → gimbal_pitch (revolute: pitch axis, Y rotation) -->
  <joint name="gimbal_pitch_joint" type="revolute">
    <parent link="gimbal_yaw"/>
    <child link="gimbal_pitch"/>
    <origin xyz="0 0 ${gimbal_pitch_height}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.785" upper="0.566" velocity="50.0" effort="100.0"/>
  </joint>

  <!-- gimbal_pitch → muzzle (fixed: barrel exit point forward of pitch axis) -->
  <joint name="muzzle_joint" type="fixed">
    <parent link="gimbal_pitch"/>
    <child link="muzzle"/>
    <origin xyz="${muzzle_forward} 0 0" rpy="0 0 0"/>
  </joint>

</robot>
